{
  "company_name": {
    "question": "Company name?",
    "type": "string",
    "required": true,
    "targets": [
      "template.company_name"
    ]
  },
  "owner_name": {
    "question": "Sales operator display name?",
    "type": "string",
    "required": true,
    "targets": [
      "template.owner_name"
    ]
  },
  "owner_email": {
    "question": "Sales operator email?",
    "type": "string",
    "required": true,
    "targets": [
      "prospecting.identity.owner_email",
      "momentum.attendee_email"
    ]
  },
  "owner_id": {
    "question": "Verified Salesforce User ID?",
    "type": "string",
    "required": true,
    "targets": [
      "prospecting.identity.sfdc_user_id"
    ]
  },
  "timezone": {
    "question": "Local IANA timezone?",
    "type": "string",
    "required": true,
    "targets": [
      "prospecting.identity.timezone",
      "momentum.display_tz"
    ]
  },
  "internal_domains": {
    "question": "Internal email domains as a JSON list?",
    "type": "list",
    "required": true,
    "targets": [
      "tooling.internal_domains"
    ]
  },
  "crm_url": {
    "question": "Salesforce HTTPS origin?",
    "type": "string",
    "required": true,
    "targets": [
      "salesforce.instance_url"
    ]
  },
  "note_initials": {
    "question": "Note initials?",
    "type": "string",
    "required": true,
    "targets": []
  },
  "product_name": {
    "question": "Product name?",
    "type": "string",
    "required": true,
    "targets": [
      "template.product_name"
    ]
  },
  "product_value": {
    "question": "One supported value statement?",
    "type": "string",
    "required": true,
    "targets": [
      "template.product_value"
    ]
  },
  "product_evidence": {
    "question": "Approved product sources and claim limits?",
    "type": "string",
    "required": true,
    "targets": [
      "template.product_evidence"
    ]
  },
  "product_review_date": {
    "question": "Product evidence review date, ISO?",
    "type": "string",
    "required": true,
    "targets": [
      "template.product_review_date"
    ]
  },
  "icp": {
    "question": "Territory, industries, personas and exclusions?",
    "type": "string",
    "required": true,
    "targets": [
      "template.icp"
    ]
  },
  "quarter_targets": {
    "question": "Quarter targets as a JSON map?",
    "type": "object",
    "required": true,
    "targets": [
      "forecast.targets"
    ]
  },
  "quarter_target_default": {
    "question": "Default quarterly target?",
    "type": "number",
    "required": true,
    "targets": [
      "forecast.target_default"
    ]
  },
  "amount_field": {
    "question": "CRM revenue field API name?",
    "type": "string",
    "required": true,
    "targets": [
      "forecast.amount_field"
    ]
  },
  "warehouse": {
    "question": "Read-only warehouse name?",
    "type": "string",
    "required": false,
    "targets": [
      "pilot_usage.warehouse",
      "prospecting.warehouse.name"
    ],
    "required_when": "warehouse"
  },
  "warehouse_timezone": {
    "question": "Timezone used by warehouse date columns?",
    "type": "string",
    "required": false,
    "targets": [
      "template.warehouse_timezone"
    ],
    "required_when": "warehouse"
  },
  "ops_channel": {
    "question": "Approved operations channel ID?",
    "type": "string",
    "required": false,
    "targets": [
      "close.ops_channel"
    ],
    "required_when": "slack"
  },
  "ops_owners": {
    "question": "Approved operations user IDs as JSON list?",
    "type": "list",
    "required": false,
    "targets": [
      "close.ops_owners"
    ],
    "required_when": "slack"
  },
  "deal_desk_channel": {
    "question": "Approved deal desk channel ID?",
    "type": "string",
    "required": false,
    "targets": [
      "close.deal_desk_channel"
    ],
    "required_when": "slack"
  },
  "artifact_dir": {
    "question": "Absolute external directory for run artifacts?",
    "type": "string",
    "required": true,
    "targets": [
      "pilot_usage.pdf.output_dir"
    ]
  },
  "crm_field_map": {
    "question": "CRM sample-to-actual API names as a JSON map?",
    "type": "object",
    "required": false,
    "default": {},
    "targets": []
  },
  "warehouse_table_map": {
    "question": "Warehouse sample-to-actual table names as JSON map?",
    "type": "object",
    "required": false,
    "default": {},
    "targets": []
  },
  "event_house_owner_ids": {
    "question": "Verified Salesforce house-owner User IDs allowed for explicitly marked event rows, or [] to disable?",
    "type": "list",
    "required": false,
    "default": [],
    "allow_empty": true,
    "targets": [
      "prospecting.event.outreach_owner_scope.house_owner_ids"
    ]
  },
  "event_include_missing_account": {
    "question": "Allow explicitly marked event rows when a complete Salesforce lookup finds no Account? Default false.",
    "type": "boolean",
    "required": false,
    "default": false,
    "targets": [
      "prospecting.event.outreach_owner_scope.include_missing_account"
    ]
  },
  "integration_setup": {
    "question": "Review every system in integrations.json and choose configure, defer or not_used. Never include credentials.",
    "type": "object",
    "required": true,
    "targets": [
      "template.integrations"
    ]
  }
}
