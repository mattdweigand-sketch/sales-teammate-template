{
  "mode": {
    "question": "Demo or configured workspace?",
    "type": "string",
    "required": true,
    "default": "demo",
    "targets": []
  },
  "company_name": {
    "question": "Company name?",
    "type": "string",
    "required": true,
    "default": "Example Seller",
    "targets": [
      "template.company_name"
    ]
  },
  "owner_name": {
    "question": "Sales operator display name?",
    "type": "string",
    "required": true,
    "default": "Sales Operator",
    "targets": [
      "template.owner_name"
    ]
  },
  "owner_email": {
    "question": "Sales operator email?",
    "type": "string",
    "required": true,
    "default": "rep@seller.example",
    "targets": [
      "prospecting.identity.owner_email",
      "momentum.attendee_email"
    ]
  },
  "owner_id": {
    "question": "Verified Salesforce User ID?",
    "type": "string",
    "required": true,
    "default": "005000000000001AAA",
    "targets": [
      "prospecting.identity.sfdc_user_id"
    ]
  },
  "timezone": {
    "question": "Local IANA timezone?",
    "type": "string",
    "required": true,
    "default": "America/Los_Angeles",
    "targets": [
      "prospecting.identity.timezone",
      "momentum.display_tz"
    ]
  },
  "internal_domains": {
    "question": "Internal email domains as a JSON list?",
    "type": "list",
    "required": true,
    "default": [
      "seller.example",
      "seller-tools.example"
    ],
    "targets": [
      "tooling.internal_domains"
    ]
  },
  "crm_url": {
    "question": "Salesforce HTTPS origin?",
    "type": "string",
    "required": true,
    "default": "https://crm.example.invalid",
    "targets": [
      "salesforce.instance_url"
    ]
  },
  "note_initials": {
    "question": "Note initials?",
    "type": "string",
    "required": true,
    "default": "SR",
    "targets": []
  },
  "product_name": {
    "question": "Product name?",
    "type": "string",
    "required": true,
    "default": "Example Product",
    "targets": [
      "template.product_name"
    ]
  },
  "product_value": {
    "question": "One supported value statement?",
    "type": "string",
    "required": true,
    "default": "Example Product helps a team coordinate a recurring business workflow.",
    "targets": [
      "template.product_value"
    ]
  },
  "product_evidence": {
    "question": "Approved product sources and claim limits?",
    "type": "string",
    "required": true,
    "default": "Fictional demonstration only. No verified product claim.",
    "targets": [
      "template.product_evidence"
    ]
  },
  "product_review_date": {
    "question": "Product evidence review date, ISO?",
    "type": "string",
    "required": true,
    "default": "2026-10-04",
    "targets": [
      "template.product_review_date"
    ]
  },
  "icp": {
    "question": "Territory, industries, personas and exclusions?",
    "type": "string",
    "required": true,
    "default": "Business services with a recurring team workflow, named owner and measurable evaluation. Demo only.",
    "targets": [
      "template.icp"
    ]
  },
  "quarter_targets": {
    "question": "Quarter targets as a JSON map?",
    "type": "object",
    "required": true,
    "default": {},
    "targets": [
      "forecast.targets"
    ]
  },
  "quarter_target_default": {
    "question": "Default quarterly target?",
    "type": "number",
    "required": true,
    "default": 250000,
    "targets": [
      "forecast.target_default"
    ]
  },
  "amount_field": {
    "question": "CRM revenue field API name?",
    "type": "string",
    "required": true,
    "default": "ARR__c",
    "targets": [
      "forecast.amount_field"
    ]
  },
  "warehouse": {
    "question": "Read-only warehouse name?",
    "type": "string",
    "required": true,
    "default": "EXAMPLE_READONLY_WH",
    "targets": [
      "pilot_usage.warehouse",
      "prospecting.warehouse.name"
    ]
  },
  "warehouse_timezone": {
    "question": "Timezone used by warehouse date columns?",
    "type": "string",
    "required": true,
    "default": "America/Los_Angeles",
    "targets": [
      "template.warehouse_timezone"
    ]
  },
  "ops_channel": {
    "question": "Approved operations channel ID?",
    "type": "string",
    "required": true,
    "default": "C0000000001",
    "targets": [
      "close.ops_channel"
    ]
  },
  "ops_owners": {
    "question": "Approved operations user IDs as JSON list?",
    "type": "list",
    "required": true,
    "default": [
      "U0000000001",
      "U0000000002"
    ],
    "targets": [
      "close.ops_owners"
    ]
  },
  "deal_desk_channel": {
    "question": "Approved deal desk channel ID?",
    "type": "string",
    "required": true,
    "default": "C0000000002",
    "targets": [
      "close.deal_desk_channel"
    ]
  },
  "artifact_dir": {
    "question": "Absolute external directory for run artifacts?",
    "type": "string",
    "required": true,
    "default": "/private/tmp/sales-demo-artifacts",
    "targets": [
      "pilot_usage.pdf.output_dir"
    ]
  },
  "crm_field_map": {
    "question": "CRM sample-to-actual API names as a JSON map?",
    "type": "object",
    "required": false,
    "default": {},
    "targets": []
  },
  "warehouse_table_map": {
    "question": "Warehouse sample-to-actual table names as JSON map?",
    "type": "object",
    "required": false,
    "default": {},
    "targets": []
  }
}
